print("=== 1. For Loop - Print 1 to 10 ===")
for i in range(1, 11):
    print(i, end=" ")
print("\n")

print("=== 2. For Loop - Even Numbers 1 to 20 ===")
for i in range(1, 21):
    if i % 2 == 0:
        print(i, end=" ")
print("\n")

print("=== 3. While Loop - Countdown ===")
count = 5
while count > 0:
    print(count)
    count -= 1
print("Go!\n")

print("=== 4. Loop with Break - Find first number divisible by 7 ===")
for i in range(1, 50):
    if i % 7 == 0:
        print(f"Found: {i}")
        break

print("\n=== 5. Loop with Continue - Skip 3 ===")
for i in range(1, 6):
    if i == 3:
        continue
    print(i)

print("\n=== 6. Nested Loop - Star Pattern ===")
for row in range(1, 6):
    for col in range(row):
        print("*", end=" ")
    print()

print("\n=== 7. Real Use - Sum of List using Loop ===")
numbers = [10, 20, 30, 40, 50]
total = 0
for num in numbers:
    total += num
print(f"List: {numbers}")
print(f"Total: {total}")
